rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }
    function isAdmin()    { return isSignedIn() && request.auth.token.role == 'admin'; }

    match /products/{productId}/{fileName} {
      // Any signed-in user (doctor or admin) needs to view product photos
      // while browsing; only admin can upload/replace them.
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /products/{productId}/variants/{fileName} {
      // Per-variant/spec photos, same read/write shape as the product photo.
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /offers/{offerId}/{fileName} {
      // Same shape as /products above: doctors browse offer images,
      // only admin uploads/replaces them.
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /shipments/{shipmentId}/documents/{fileName} {
      // Shipment documents are internal business records — admin only,
      // unlike product/offer photos which doctors also need to read.
      allow read, write: if isAdmin();
    }

    // Tooth photo archive — mirrors firestore.rules' canAccessOwner logic:
    // a doctor's own uid, or membership in the medical center at ownerId
    // via the `centerId` custom claim (set by createDoctorAccount /
    // setCenterMembership), not a Firestore lookup — keeps this consistent
    // with why firestore.rules' isCenterMember avoids get() too.
    match /clinics/{ownerId}/patients/{patientId}/teeth/{toothNumber}/{visitId}/{fileName} {
      allow read, write: if isAdmin() || (isSignedIn() && (
        request.auth.uid == ownerId || request.auth.token.centerId == ownerId
      ));
    }
  }
}
